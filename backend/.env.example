ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string

DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/book_platform
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
S3_BUCKET_NAME=book-platform-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,epub,docx,txt

OPENAI_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=

CORS_ORIGINS=http://localhost:4200,http://localhost:8080
